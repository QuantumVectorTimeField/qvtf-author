{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QVTF Author",
  "version": "1.0.0",
  "identifier": "org.qvtf.author",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "QVTF Author — Scientific Markdown & LaTeX Publisher",
        "width": 1280,
        "height": 850,
        "minWidth": 800,
        "minHeight": 550,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "copyright": "Copyright © 2026 Simeon Peter Marriott • QVTF.org",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
